{
  "model": "qwen3.5-omni-plus-realtime",
  "want_transcription": true,
  "init": true,
  "steps": [
    {
      "name": "3.5 passes appends through untouched (48 bytes = 1 ms at 24 kHz)",
      "client": {"event_id":"a1","type":"input_audio_buffer.append","audio":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"},
      "expect": {
        "to_upstream": [
          {"event_id":"a1","type":"input_audio_buffer.append","audio":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"}
        ]
      }
    },
    {
      "name": "speech_started passes through",
      "upstream": {"event_id":"event_up_10","type":"input_audio_buffer.speech_started","audio_start_ms":10,"item_id":"item_t1"},
      "expect": {
        "to_client": [
          {"event_id":"event_up_10","type":"input_audio_buffer.speech_started","audio_start_ms":10,"item_id":"item_t1"}
        ]
      }
    },
    {
      "name": "committed attributes the appended bytes to the item",
      "upstream": {"event_id":"event_up_11","type":"input_audio_buffer.committed","item_id":"item_t1"},
      "expect": {
        "to_client": [
          {"event_id":"event_up_11","type":"input_audio_buffer.committed","item_id":"item_t1"}
        ]
      }
    },
    {
      "name": "user item created",
      "upstream": {"event_id":"event_up_12","type":"conversation.item.created","item":{"id":"item_t1","object":"realtime.item","type":"message","status":"in_progress","role":"user","content":[{"type":"input_audio"}]}},
      "expect": {
        "to_client_types": ["conversation.item.added", "conversation.item.done"]
      }
    },
    {
      "name": "empty confirmed text produces no delta",
      "upstream": {"event_id":"event_up_13","type":"conversation.item.input_audio_transcription.delta","item_id":"item_t1","content_index":0,"text":"","stash":"今天","language":"zh","emotion":"neutral"},
      "expect": {}
    },
    {
      "name": "first confirmed text is emitted whole",
      "upstream": {"event_id":"event_up_14","type":"conversation.item.input_audio_transcription.delta","item_id":"item_t1","content_index":0,"text":"今天","stash":"天气不错"},
      "expect": {
        "to_client": [
          {"event_id":"event_up_14","type":"conversation.item.input_audio_transcription.delta","item_id":"item_t1","content_index":0,"delta":"今天"}
        ]
      }
    },
    {
      "name": "extension of the confirmed prefix emits only the tail",
      "upstream": {"event_id":"event_up_15","type":"conversation.item.input_audio_transcription.delta","item_id":"item_t1","content_index":0,"text":"今天天气不错，","stash":""},
      "expect": {
        "to_client": [
          {"event_id":"event_up_15","type":"conversation.item.input_audio_transcription.delta","item_id":"item_t1","content_index":0,"delta":"天气不错，"}
        ]
      }
    },
    {
      "name": "unchanged confirmed text is suppressed",
      "upstream": {"event_id":"event_up_16","type":"conversation.item.input_audio_transcription.delta","item_id":"item_t1","content_index":0,"text":"今天天气不错，","stash":"阳光"},
      "expect": {}
    },
    {
      "name": "a new sentence starts with empty text: suppressed, base moves on",
      "upstream": {"event_id":"event_up_17","type":"conversation.item.input_audio_transcription.delta","item_id":"item_t1","content_index":0,"text":"","stash":"阳光"},
      "expect": {}
    },
    {
      "name": "second sentence confirmed text is emitted whole",
      "upstream": {"event_id":"event_up_18","type":"conversation.item.input_audio_transcription.delta","item_id":"item_t1","content_index":0,"text":"阳光","stash":"明媚。"},
      "expect": {
        "to_client": [
          {"event_id":"event_up_18","type":"conversation.item.input_audio_transcription.delta","item_id":"item_t1","content_index":0,"delta":"阳光"}
        ]
      }
    },
    {
      "name": "completed catches up the unconfirmed tail, adds duration usage and bills the transcription",
      "upstream": {"event_id":"event_up_19","type":"conversation.item.input_audio_transcription.completed","item_id":"item_t1","content_index":0,"transcript":"今天天气不错，阳光明媚。"},
      "expect": {
        "to_client": [
          {"event_id":"event_axh_4","type":"conversation.item.input_audio_transcription.delta","item_id":"item_t1","content_index":0,"delta":"明媚。"},
          {"event_id":"event_up_19","type":"conversation.item.input_audio_transcription.completed","item_id":"item_t1","content_index":0,"transcript":"今天天气不错，阳光明媚。","usage":{"type":"duration","seconds":0.001}}
        ],
        "usage": [
          {"kind":"transcription","item_id":"item_t1","model":"qwen3-asr-flash-realtime","duration_seconds":0.001,"nil_usage":true}
        ]
      }
    },
    {
      "name": "the cached item now carries the transcript",
      "client": {"event_id":"c1","type":"conversation.item.retrieve","item_id":"item_t1"},
      "expect": {
        "to_client": [
          {"event_id":"event_axh_5","type":"conversation.item.retrieved","item":{"id":"item_t1","object":"realtime.item","type":"message","status":"completed","role":"user","content":[{"type":"input_audio","transcript":"今天天气不错，阳光明媚。"}]}}
        ]
      }
    },
    {
      "name": "a completed with no prior deltas emits the whole transcript as a catch-up delta and still gets usage (zero seconds for an unknown buffer)",
      "upstream": {"event_id":"event_up_20","type":"conversation.item.input_audio_transcription.completed","item_id":"item_t2","content_index":0,"transcript":"喂，你好。"},
      "expect": {
        "to_client": [
          {"event_id":"event_axh_6","type":"conversation.item.input_audio_transcription.delta","item_id":"item_t2","content_index":0,"delta":"喂，你好。"},
          {"event_id":"event_up_20","type":"conversation.item.input_audio_transcription.completed","item_id":"item_t2","content_index":0,"transcript":"喂，你好。","usage":{"type":"duration","seconds":0}}
        ],
        "usage": [
          {"kind":"transcription","item_id":"item_t2","model":"qwen3-asr-flash-realtime","duration_seconds":0,"nil_usage":true}
        ]
      }
    },
    {
      "name": "transcription failed passes through",
      "upstream": {"type":"conversation.item.input_audio_transcription.failed","item_id":"item_t3","content_index":0,"error":{"code":"x","message":"y"}},
      "expect": {
        "to_client": [
          {"type":"conversation.item.input_audio_transcription.failed","item_id":"item_t3","content_index":0,"error":{"code":"x","message":"y"}}
        ]
      }
    },
    {
      "name": "client clear passes through and upstream cleared passes through",
      "client": {"type":"input_audio_buffer.clear"},
      "expect": {
        "to_upstream": [{"type":"input_audio_buffer.clear"}]
      }
    },
    {
      "name": "cleared",
      "upstream": {"event_id":"event_up_21","type":"input_audio_buffer.cleared"},
      "expect": {
        "to_client": [{"event_id":"event_up_21","type":"input_audio_buffer.cleared"}]
      }
    },
    {
      "name": "session.finished is dropped",
      "upstream": {"event_id":"event_up_22","type":"session.finished"},
      "expect": {}
    },
    {
      "name": "3.8-style deltas carry an empty text and a growing stash: nothing is emitted",
      "upstream": {"event_id":"event_up_23","type":"conversation.item.input_audio_transcription.delta","item_id":"item_t4","content_index":0,"text":"","stash":"喂"},
      "expect": {}
    },
    {
      "name": "still nothing while only the stash grows",
      "upstream": {"event_id":"event_up_24","type":"conversation.item.input_audio_transcription.delta","item_id":"item_t4","content_index":0,"text":"","stash":"喂，你好"},
      "expect": {}
    },
    {
      "name": "completed then emits the whole transcript as exactly one catch-up delta",
      "upstream": {"event_id":"event_up_25","type":"conversation.item.input_audio_transcription.completed","item_id":"item_t4","content_index":0,"transcript":"喂，你好。"},
      "expect": {
        "to_client": [
          {"event_id":"event_axh_7","type":"conversation.item.input_audio_transcription.delta","item_id":"item_t4","content_index":0,"delta":"喂，你好。"},
          {"event_id":"event_up_25","type":"conversation.item.input_audio_transcription.completed","item_id":"item_t4","content_index":0,"transcript":"喂，你好。","usage":{"type":"duration","seconds":0}}
        ],
        "usage": [
          {"kind":"transcription","item_id":"item_t4","model":"qwen3-asr-flash-realtime","duration_seconds":0,"nil_usage":true}
        ]
      }
    }
  ]
}
